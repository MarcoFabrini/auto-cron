DOMAIN=autocron.yourdomain.com

MARIADB_DATABASE=autocron
MARIADB_USER=autocron

# generate with: openssl rand -hex 32
MARIADB_PASSWORD=
APP_SECRET=
JWT_PASSPHRASE=

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
###< lexik/jwt-authentication-bundle ###

AUTOCRON_REGISTRY=ghcr.io/marcofabrini
AUTOCRON_TAG=latest
API_PORT=8080

# email (optional)
#MAILER_DSN=smtp://user:password@smtp.example.com:587
#MAILER_FROM=noreply@yourdomain.com

# overrides (optional — sane defaults are derived automatically, see entrypoint.sh)
#CORS_ALLOW_ORIGIN=
#TRUSTED_PROXIES=REMOTE_ADDR

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###
