# API base URL. Vuoto = path relativi (FrankenPHP serve /api sulla stessa origin).
# In dev locale standalone (frontend fuori da Lando): VITE_API_URL=http://localhost:80
VITE_API_URL=

# VAPID public key per Web Push subscription.
# Copia il valore di VAPID_PUBLIC_KEY dal .env root.
VITE_VAPID_PUBLIC_KEY=
