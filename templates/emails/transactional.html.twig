{% extends 'emails/base.html.twig' %}

{% block content %}
    <h1 style="margin:0 0 16px; font-size:22px; font-weight:700; color:#0f172a;">{{ heading }}</h1>

    {% if greeting %}
        <p style="margin:0 0 16px; font-size:15px; line-height:1.6; color:#334155;">{{ greeting }}</p>
    {% endif %}

    {% for paragraph in paragraphs %}
        <p style="margin:0 0 16px; font-size:15px; line-height:1.6; color:#334155;">{{ paragraph }}</p>
    {% endfor %}

    {% if button %}
        <table role="presentation" cellpadding="0" cellspacing="0" style="margin:8px 0 20px;">
            <tr>
                <td style="border-radius:8px; background-color:#0f172a;">
                    <a href="{{ button.url }}" style="display:inline-block; padding:12px 24px; font-size:15px; font-weight:600; color:#ffffff; text-decoration:none;">{{ button.label }}</a>
                </td>
            </tr>
        </table>
        <p style="margin:0 0 16px; font-size:13px; line-height:1.6; color:#64748b; word-break:break-all;">{{ button.url }}</p>
    {% endif %}

    {% if outro %}
        <p style="margin:0; font-size:14px; line-height:1.6; color:#64748b;">{{ outro }}</p>
    {% endif %}
{% endblock %}
